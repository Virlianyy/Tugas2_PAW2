{
  "info": {
    "name": "PAWII - To-Do API",
    "description": "Automated Test Script untuk Project Akhir To-Do API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET All To-Do",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/todo",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["todo"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code adalah 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response berupa array', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST Tambah To-Do",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"judul\": \"Tugas Baru\",\n  \"deskripsi\": \"Mengerjakan projek akhir\",\n  \"tenggatWaktu\": \"2026-10-25\",\n  \"status\": \"Belum Selesai\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/todo",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["todo"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code adalah 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "pm.environment.set('todoId', jsonData.id || jsonData._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET Satu To-Do",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/todo/{{todoId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["todo", "{{todoId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code adalah 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Data memiliki properti judul', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('judul');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT Update To-Do",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Selesai\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/todo/{{todoId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["todo", "{{todoId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code adalah 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE To-Do",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/todo/{{todoId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["todo", "{{todoId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code adalah 204', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}